# Token de Hugging Face — necesario para `lerobot-record` (push de datasets) y
# `lerobot-train --wandb.enable=true`. Obtén el token en https://huggingface.co/settings/tokens
HUGGINGFACE_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Tu usuario de HF (lo descubre `hf auth whoami` después de hacer login).
# Se usa para construir repo_ids de datasets y policies: ${HF_USER}/so101_pick_cube
HF_USER=tu_usuario_hf
