/* Layout y colores de la TUI DUM-E. Base: theme `hacker` (so101_cli/dume/theme.py)
   = fósforo verde sobre negro. Las variables $primary/$accent/$surface/... salen
   de ese theme; acá solo afinamos el layout y subimos el "voltaje" del verde. */

Screen {
    background: $background;   /* negro puro: las cards verdes flotan sobre negro */
}

#main {
    height: 1fr;
}

/* ---- sidebar -------------------------------------------------------- */

#sidebar {
    width: 28;
    background: $panel;
    border-right: tall $primary;
    padding: 1 1;
}

#sidebar > ListItem {
    padding: 0 1;
}

#sidebar > ListItem.--highlight {
    background: $primary 25%;
    color: $accent;
    text-style: bold;
}

/* ---- content + cockpit grid ---------------------------------------- */

#content {
    width: 1fr;
    height: 1fr;
}

HomeView {
    height: 1fr;
}

#cockpit {
    grid-size: 2 3;
    grid-gutter: 1 1;
    padding: 1 1;
    height: 1fr;
}

.card {
    border: round $primary 80%;
    border-title-color: $accent;
    border-title-style: bold;
    padding: 0 1;
    height: 1fr;
    overflow-y: auto;
}

.card:focus-within {
    border: round $accent;
}

.card-body {
    height: auto;
}

/* ---- command preview ----------------------------------------------- */

.command-preview {
    background: $surface;
    color: $accent;
    border-left: thick $primary;
    padding: 0 1;
}

/* ---- teleop (formulario Fase 2) ------------------------------------ */

TeleopView {
    height: 1fr;
}

#teleop-scroll {
    height: 1fr;
    padding: 1 2;
}

#teleop-head {
    margin-bottom: 1;
}

/* las cards del form se dimensionan al contenido (no 1fr como en el cockpit) */
#card-teleop-cfg, #card-teleop-pre {
    height: auto;
    margin-bottom: 1;
}

.form-row {
    height: 3;
    align: left middle;
}

.form-label {
    width: 18;
    content-align: left middle;
    color: $secondary;
}

.form-input {
    width: 36;
}

.section-label {
    margin: 1 0 0 0;
}

#teleop-buttons {
    height: auto;
    margin-top: 1;
}

#teleop-buttons Button {
    margin-right: 2;
}

/* ---- placeholder vista próxima fase -------------------------------- */

PlaceholderView {
    height: 1fr;
}

.placeholder {
    width: auto;
    height: auto;
    padding: 2 4;
    border: round $warning 70%;
    content-align: center middle;
}

/* ---- help modal ----------------------------------------------------- */

HelpScreen {
    align: center middle;
}

#help-box {
    width: auto;
    height: auto;
    padding: 1 2;
    border: thick $accent;
    background: $panel;
}
